		"services-live-scenario": "node scripts/services-live-scenario.mjs",
		"xr-live-scenario": "node scripts/xr-live-scenario.mjs",
		"ecs-live-scenario": "node scripts/ecs-live-scenario.mjs",
		"entities-hierarchy-live-scenario": "node scripts/entities-hierarchy-live-scenario.mjs",
