		"fbx-live-scenario": "node scripts/fbx-live-scenario.mjs",
		"all-live-scenarios": "node scripts/run-all-live-scenarios.mjs",
		"audit-live-coverage": "node scripts/audit-live-coverage.mjs",
		"whole-editor-ui-audit": "node scripts/whole-editor-ui-audit.mjs",
		"relay": "node ./build/src/relay-server.mjs",
		"inspect": "mcp-inspector node ./build/src/index.mjs",
		"package": "yarn build && yarn bundle && yarn sync-manifest-tools && yarn sync-feature-inventory && mcpb pack . babylonjs-editor.mcpb"
	},
	"license": "Apache-2.0",
	"main": "build/src/index.mjs",
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
