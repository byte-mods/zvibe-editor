		"platforms-live-scenario": "node scripts/platforms-live-scenario.mjs",
		"platform-restart-live-scenario": "node scripts/platform-restart-live-scenario.mjs",
		"device-tooling-live-scenario": "node scripts/device-tooling-live-scenario.mjs",
