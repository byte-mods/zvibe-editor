{
	"name": "babylonjs-editor-mcp-server",
	"version": "0.1.0",
	"description": "Babylon.js Editor MCP Server",
	"productName": "Babylon.js Editor MCP Server",
	"scripts": {
		"build": "tsc -p .",
		"watch": "concurrently \"tsc -p . --watch\" \"yarn bundle --watch\" -c bgYellow.bold,bgBlue.bold --names mcp-server-ts,mcp-server-bundle",
		"bundle": "esbuild src/index.mts --bundle --platform=node --format=esm --target=node20 --outfile=server/index.mjs --banner:js=\"import{createRequire as ___mcpbRequire}from'module';const require=___mcpbRequire(import.meta.url);\"",
		"validate": "yarn check-manifest-tools && yarn check-feature-inventory && yarn test:aseprite-tools && yarn test:fbx-tools && node scripts/validate-contract.mjs",
		"sync-manifest-tools": "node scripts/sync-manifest-tools.mjs --write",
		"check-manifest-tools": "node scripts/sync-manifest-tools.mjs --check",
		"test:manifest-tools": "node --test scripts/sync-manifest-tools.test.mjs",
		"sync-feature-inventory": "node scripts/generate-feature-inventory.mjs --write",
		"check-feature-inventory": "node scripts/generate-feature-inventory.mjs --check",
		"test:feature-inventory": "node --test scripts/generate-feature-inventory.test.mjs",
		"test:aseprite-tools": "yarn build && node --test scripts/aseprite-tools.test.mjs",
		"test:fbx-tools": "yarn build && node --test scripts/fbx-tools.test.mjs",
		"live-scenario": "node scripts/live-scenario.mjs",
		"visual-scripting-live-scenario": "node scripts/visual-scripting-live-scenario.mjs",
		"gui-interaction-live-scenario": "node scripts/gui-interaction-live-scenario.mjs",
		"behavior-graphs-live-scenario": "node scripts/behavior-graphs-live-scenario.mjs",
		"addressables-live-scenario": "node scripts/addressables-live-scenario.mjs",
