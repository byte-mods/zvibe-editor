		"ui-toolkit-live-scenario": "node scripts/ui-toolkit-live-scenario.mjs",
		"hybrid-physics-live-scenario": "node scripts/hybrid-physics-live-scenario.mjs",
		"version-control-65-live-scenario": "node scripts/version-control-65-live-scenario.mjs",
