		"mobile-system-live-scenario": "node scripts/mobile-system-live-scenario.mjs",
		"console-server-live-scenario": "node scripts/console-server-live-scenario.mjs",
		"runtime-ai-live-scenario": "node scripts/runtime-ai-live-scenario.mjs",
