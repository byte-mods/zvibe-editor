{
	"name": "babylonjs-editor-quixel-plugin",
	"version": "5.0.8",
	"description": "",
	"productName": "Babylon.js Editor Quixel Plugin",
	"scripts": {
		"build": "tsc -p .",
		"watch": "tsc -p . --watch"
	},
	"main": "build/index.js",
	"typings": "declaration/index.d.ts",
	"zvibeEditor": {
		"apiVersion": 1,
		"id": "babylon.editor.quixel",
		"displayName": "Quixel Bridge",
		"description": "Loopback Quixel Bridge import integration for Zvibe Editor.",
		"capabilities": [
			"tests",
			"editor"
		],
		"contributes": {
			"tests": [
				{
					"id": "babylon.editor.quixel.listener",
					"title": "Quixel Bridge listener"
				}
			]
		}
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/node": "^22",
		"babylonjs-editor": "1.0.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"babylonjs": "9.12.1",
		"fs-extra": "11.2.0",
		"sharp": "0.34.3"
	}
}
